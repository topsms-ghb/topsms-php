    "authors": [
        { "name": "TopSMS.cz", "email": "info@topsms.cz", "homepage": "https://www.topsms.cz" }
    ],
    "support": {
        "email": "info@topsms.cz",
        "docs": "https://www.topsms.cz/api-integrace/rest-api"
    },
    "require": {
        "php": ">=7.4",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "autoload": {
