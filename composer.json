{
    "name": "topsms/topsms-php",
    "description": "PHP client for the TopSMS SMS gateway API (topsms.eu / topsms.cz): send SMS, delivery status, credit balance and webhook signature verification.",
    "keywords": ["sms", "sms-gateway", "sms-api", "topsms", "bulk-sms", "germany", "austria", "eu", "czech", "slovakia"],
    "homepage": "https://www.topsms.cz",
    "license": "MIT",
    "authors": [
        { "name": "TopSMS", "email": "info@topsms.cz", "homepage": "https://www.topsms.cz" }
    ],
    "support": {
        "email": "info@topsms.cz",
        "docs": "https://www.topsms.cz/api-integrace/rest-api"
    },
    "require": {
        "php": ">=7.4",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": { "TopSms\\": "src/" }
    },
    "minimum-stability": "stable"
}
